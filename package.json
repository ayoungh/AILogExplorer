{
  "name": "ai-log-explorer",
  "version": "0.1.0",
  "description": "Explore local AI conversation and agent logs without uploading them.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayoungh/AILogExplorer.git"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "next dev --webpack --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "examples:generate": "node scripts/generate-examples.mjs",
    "examples:check": "node scripts/generate-examples.mjs --check",
    "check:public": "node scripts/check-public-tree.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.8",
    "better-sqlite3": "^12.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
